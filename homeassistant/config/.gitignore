# Example .gitignore file for your config dir.
# An * ensures that everything will be ignored.
*
# You can whitelist files/folders with !, these will not be ignored.
!*.yaml
!.gitignore
!*.md

# Custom integrations: HACS-installed ones (impk, …) stay ignored; only our own
# hand-written ones are version-controlled. Whitelist each one explicitly.
# `!custom_components/` lets git descend into the dir (without it the lines below
# have no effect); the two per-plugin lines re-include the dir + all its contents.
!custom_components/
!custom_components/spacerek/
!custom_components/spacerek/**
# …but never the Python bytecode caches.
custom_components/spacerek/**/__pycache__/

# Ignore folders.
.storage
.cloud
.google.token

# Ensure these YAML files are ignored, otherwise your secret data/credentials will leak.
ip_bans.yaml
secrets.yaml
known_devices.yaml
